# Never commit real credentials. Pass environment variables through deployment secrets.
MEGA_ORIGIN=https://play.antimatterinnovations.com
MEGA_DB=.data/mega.sqlite
PORT=8080

# Web Google OpenID Connect client (registered HTTPS callback: /auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native Google token aud is the server/Web OAuth client ID, not the Android package.
GOOGLE_NATIVE_AUDIENCES=
GOOGLE_AUTHORIZED_PARTIES=

# Apple web Services ID (registered HTTPS callback: /auth/callback/apple)
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM with escaped newlines is supported; inject as a deployment secret.
APPLE_PRIVATE_KEY=
# Native Apple audience: exact application bundle ID(s).
APPLE_NATIVE_AUDIENCES=

# Privacy/account deletion remains off until Antimatter Innovations approves a policy version.
MEGA_ACCOUNT_DELETION_ENABLED=false
MEGA_PRIVACY_POLICY_VERSION=

# Native store purchase release remains disabled until provider consoles and device acceptance are complete.
MEGA_PURCHASES_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PLAY_PRODUCT_CROWNS_100=
GOOGLE_PLAY_PRODUCT_CROWNS_525=
GOOGLE_PLAY_PRODUCT_CROWNS_1100=
GOOGLE_PLAY_PRODUCT_REMOVE_ADS=
APPLE_STORE_BUNDLE_ID=
# Numeric App Store app ID; required when APPLE_STORE_ENVIRONMENT=Production.
APPLE_STORE_APP_ID=
APPLE_STORE_ENVIRONMENT=
APPLE_STORE_ROOTS_FILE=
APPLE_STORE_PRODUCT_CROWNS_100=
APPLE_STORE_PRODUCT_CROWNS_525=
APPLE_STORE_PRODUCT_CROWNS_1100=
APPLE_STORE_PRODUCT_REMOVE_ADS=

# Ads remain off until the native Mobile Ads + consent implementation and physical-device acceptance are complete.
MEGA_AD_MODE=off
MEGA_AD_CONSENT_VERSION=
ADMOB_ANDROID_REWARDED_UNIT=
ADMOB_ANDROID_INTERSTITIAL_UNIT=
ADMOB_IOS_REWARDED_UNIT=
ADMOB_IOS_INTERSTITIAL_UNIT=
