{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "mega-xo-api",
  "scope": "team_wS9BpnXbYRZahs1DiSueN3SS",
  "teamId": "team_wS9BpnXbYRZahs1DiSueN3SS",
  "orgId": "team_wS9BpnXbYRZahs1DiSueN3SS",
  "projectId": "mega-xo-api",
  "framework": null,
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 15,
      "runtime": "nodejs22.x"
    },
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15,
      "runtime": "nodejs22.x"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
