{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "node ../../scripts/p21/build-web.js --output apps/web/dist",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/legacy-game",
      "destination": "/legacy-game/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/legacy-game/",
      "destination": "/legacy-game/index.html"
    },
    {
      "source": "/legal/privacy",
      "destination": "/pages/legal/privacy.html"
    },
    {
      "source": "/legal/terms",
      "destination": "/pages/legal/terms.html"
    },
    {
      "source": "/legal/support",
      "destination": "/pages/legal/support.html"
    },
    {
      "source": "/legal/delete-account",
      "destination": "/pages/legal/delete-account.html"
    },
    {
      "source": "/legal/privacy-choices",
      "destination": "/pages/legal/privacy-choices.html"
    },
    {
      "source": "/play",
      "destination": "/pages/play.html"
    },
    {
      "source": "/casual",
      "destination": "/pages/casual.html"
    },
    {
      "source": "/ranked",
      "destination": "/pages/ranked.html"
    },
    {
      "source": "/tournaments",
      "destination": "/pages/tournaments.html"
    },
    {
      "source": "/season",
      "destination": "/pages/season.html"
    },
    {
      "source": "/friends",
      "destination": "/pages/friends.html"
    },
    {
      "source": "/challenge",
      "destination": "/pages/challenge.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/pages/leaderboard.html"
    },
    {
      "source": "/rewards",
      "destination": "/pages/rewards.html"
    },
    {
      "source": "/themes",
      "destination": "/pages/themes.html"
    },
    {
      "source": "/profile",
      "destination": "/pages/profile.html"
    },
    {
      "source": "/settings",
      "destination": "/pages/settings.html"
    },
    {
      "source": "/account",
      "destination": "/pages/account.html"
    },
    {
      "source": "/how-to-play",
      "destination": "/pages/how-to-play.html"
    },
    {
      "source": "/support",
      "destination": "/pages/support.html"
    },
    {
      "source": "/about",
      "destination": "/pages/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/pages/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/pages/terms.html"
    },
    {
      "source": "/delete-account",
      "destination": "/pages/delete-account.html"
    },
    {
      "source": "/privacy-choices",
      "destination": "/pages/privacy-choices.html"
    },
    {
      "source": "/help",
      "destination": "/pages/help.html"
    },
    {
      "source": "/news",
      "destination": "/pages/news.html"
    },
    {
      "source": "/status",
      "destination": "/pages/status.html"
    },
    {
      "source": "/accessibility",
      "destination": "/pages/accessibility.html"
    },
    {
      "source": "/offline",
      "destination": "/pages/offline.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/game",
      "destination": "/pages/game.html"
    },
    {
      "source": "/game/",
      "destination": "/pages/game.html"
    },
    {
      "source": "/store",
      "destination": "/pages/store.html"
    },
    {
      "source": "/sponsors",
      "destination": "/pages/sponsors.html"
    },
    {
      "source": "/ads",
      "destination": "/pages/ads.html"
    },
    {
      "source": "/download",
      "destination": "/pages/download.html"
    },
    {
      "source": "/faq",
      "destination": "/pages/faq.html"
    },
    {
      "source": "/press",
      "destination": "/pages/press.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/game",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/game/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/play",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/legacy-game",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/legacy-game/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/profile",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/friends",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/settings",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/challenge",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/offline",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/status",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/404",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/pages/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/legal/:name.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/legal/privacy.html",
      "headers": [
        {
          "key": "Link",
          "value": "<https://megaxo.online/privacy>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/legal/terms.html",
      "headers": [
        {
          "key": "Link",
          "value": "<https://megaxo.online/terms>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/legal/support.html",
      "headers": [
        {
          "key": "Link",
          "value": "<https://megaxo.online/support>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/legal/delete-account.html",
      "headers": [
        {
          "key": "Link",
          "value": "<https://megaxo.online/delete-account>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/legal/privacy-choices.html",
      "headers": [
        {
          "key": "Link",
          "value": "<https://megaxo.online/privacy-choices>; rel=\"canonical\""
        }
      ]
    }
  ]
}
