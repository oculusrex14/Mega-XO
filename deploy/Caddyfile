{
 email {$ACME_EMAIL}
 admin off
 servers {
  trusted_proxies static {$MEGA_TRUSTED_PROXIES:127.0.0.1/32}
  trusted_proxies_strict
 }
 log {
  level WARN
  format filter {
   request delete
   headers delete
   resp_headers delete
   wrap json
  }
 }
}
{$MEGA_HOSTNAME} {
 encode zstd gzip
 header -Server
 header Strict-Transport-Security "max-age=31536000"
 @private path /internal/* /metrics /status /server/* /scripts/* /deploy/* /tests/* /.git/* /.env* /src/authority.js
 respond @private 404
 request_body {
  max_size 300000
 }
 reverse_proxy app:8080 {
  header_up X-Mega-Proxy-Key {$MEGA_PROXY_SECRET}
  header_up X-Mega-Client-IP {client_ip}
  header_up -X-Forwarded-Host
  transport http {
   dial_timeout 3s
   response_header_timeout 15s
  }
 }
}
