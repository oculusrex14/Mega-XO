{
 email {$ACME_EMAIL}
 admin off
 servers {
  trusted_proxies static {$MEGA_TRUSTED_PROXIES:127.0.0.1/32}
  trusted_proxies_strict
 }
 log {
  level WARN
  format filter {
   request delete
   headers delete
   resp_headers delete
   wrap json
  }
 }
}
# The game's canonical public origin. Serves the whole V5 application (web bundle + API + realtime)
# from ONE hostname, because the browser client reads /api and opens new URL('/realtime/v1',
# page.origin) same-origin and the session cookie is __Host-mega_session (host-only, no Domain).
megaxo.online {
 encode zstd gzip
 header -Server
 header Strict-Transport-Security "max-age=31536000"
 @private path /internal/* /metrics /status /server/* /scripts/* /deploy/* /tests/* /.git/* /.env* /src/authority.js
 respond @private 404
 request_body {
  max_size 300000
 }
 reverse_proxy 172.18.0.1:8080 {
  header_up X-Mega-Proxy-Key {$MEGA_PROXY_SECRET}
  header_up X-Mega-Client-IP {client_ip}
  header_up -X-Forwarded-Host
  transport http {
   dial_timeout 3s
   response_header_timeout 15s
  }
 }
}

# The retired game host. The owner moved the product to megaxo.online and reserved the antimatter
# domain for the parent-company website, so nothing is served from here any more; a permanent
# redirect keeps old links and installed clients pointed at the canonical origin. This is the only
# remaining reference, and it forwards rather than serves.
play.antimatterinnovations.com {
 redir https://megaxo.online{uri} 308
}

www.megaxo.online {
 redir https://megaxo.online{uri} permanent
}

# V5.1 signed Game Core edge (additive). Routes ONLY /ingress/* to the isolated host Core proxy,
# which forwards to the single Core instance. Everything else is refused with a real 404. This block
# is fully independent of the V4 site block above; removing it and reloading reverts to V4-only.
core.megaxo.online {
 encode zstd gzip
 header -Server
 header Strict-Transport-Security "max-age=31536000"
 header X-Robots-Tag "noindex, nofollow"
 request_body {
  max_size 131072
 }
 @ingress path /ingress/*
 handle @ingress {
  reverse_proxy 172.18.0.1:8096 {
   header_up -X-Forwarded-Host
   transport http {
    dial_timeout 3s
    response_header_timeout 15s
   }
  }
 }
 respond 404
}
