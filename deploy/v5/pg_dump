#!/bin/sh
# Host-side PostgreSQL 16 pg_dump wrapper.
#
# The P15 sealer spawns `pg_dump` with a fixed argv and a scrubbed environment
# containing only PGHOST/PGPORT/PGDATABASE/PGUSER/PGSSLMODE/PGCONNECT_TIMEOUT/
# PGAPPNAME/PGPASSFILE/PGSSLROOTCERT plus PATH/LANG/LC_ALL, so the image
# reference is read from the host's own protected state file rather than from
# the caller's environment. This wrapper runs that pinned image on the host
# network, forwards ONLY the connection environment libpq needs, and
# bind-mounts the pgpass and provider CA read-only at their identical absolute
# paths. stdout is byte-exact and the container exit status is propagated, so
# a failed dump can never be sealed as a success.
set -eu

ROOT=${V5_ROOT:-/opt/mega-xo-v5-production}
image_file=$ROOT/state/pg-image-ref
[ -f "$image_file" ] || { echo 'V5_PG_DUMP_REFUSED: pinned image reference missing' >&2; exit 64; }
image=$(tr -d '\r\n' < "$image_file")
case "$image" in
  postgres:16-alpine@sha256:????????????????????????????????????????????????????????????????) ;;
  *) echo 'V5_PG_DUMP_REFUSED: unpinned postgres image reference' >&2; exit 64 ;;
esac
if [ -n "${V5_PG_IMAGE:-}" ] && [ "$V5_PG_IMAGE" != "$image" ]; then
  echo 'V5_PG_DUMP_REFUSED: V5_PG_IMAGE does not match the pinned reference' >&2
  exit 64
fi

mounts=''
for var in PGPASSFILE PGSSLROOTCERT; do
  eval "value=\${$var:-}"
  if [ -n "$value" ]; then
    case "$value" in
      /*) ;;
      *) echo "V5_PG_DUMP_REFUSED: $var must be absolute" >&2; exit 64 ;;
    esac
    [ -f "$value" ] || { echo "V5_PG_DUMP_REFUSED: $var missing" >&2; exit 64; }
    mounts="$mounts -v $value:$value:ro"
  fi
done

# shellcheck disable=SC2086
exec docker run --rm -i --user 0:0 --network host \
  -e PGHOST -e PGPORT -e PGDATABASE -e PGUSER -e PGSSLMODE -e PGCONNECT_TIMEOUT \
  -e PGAPPNAME -e PGPASSFILE -e PGSSLROOTCERT $mounts \
  "$image" pg_dump "$@"
