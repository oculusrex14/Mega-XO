[Unit]
Description=Mega XO V5 production operational health check (authority service, edge ingress, /opsz, backup freshness)
Documentation=file:/opt/mega-xo-v5-production/bin/host-health-monitor.sh
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/mega-xo-v5-production/bin/host-health-monitor.sh /opt/mega-xo-v5-production
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/mega-xo-v5-production/monitoring
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
