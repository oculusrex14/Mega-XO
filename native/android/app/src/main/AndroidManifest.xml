<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET permission until P20-03 has a complete authenticated API transport.
         WebViewClient interception does not run for POST requests; relying on it alone
         would allow offline prototype POST bodies to reach the network. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.MegaXO">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${megaAdMobAppId}" />
        <activity
            android:name=".MegaXOActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
