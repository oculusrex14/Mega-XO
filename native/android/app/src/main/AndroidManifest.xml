<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- INTERNET and ACCESS_NETWORK_STATE are REQUIRED by the owner-authorised LAN-local private
         room host: a phone must be able to run a room server and discover one on the same Wi-Fi
         with no internet. Android grants a normal app no network access at all without INTERNET,
         and NsdManager (mDNS/DNS-SD discovery) refuses to run without it - removing it made the
         host crash on start. This does NOT grant an outward internet capability by itself: every
         outbound origin is still constrained by the app's WebView origin gate, by
         network_security_config (cleartext denied except loopback) and by MegaAndroidLanBridge's
         private-literal check. AD_ID stays removed: this app serves no ads SDK in the offline
         build and tracks nothing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- LAN-local discovery on Android 13+ (API 33) may also require NEARBY_WIFI_DEVICES.
         Requested with neverForLocation so it can never be used to derive physical location. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- Only explicit player opt-in can request Android 13+ local-alert permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MegaXO">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${megaAdMobAppId}" />
        <activity
            android:name=".MegaXOActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
