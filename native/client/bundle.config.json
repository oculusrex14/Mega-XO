      "rel": "preconnect",
      "href": "https://fonts.googleapis.com"
    },
    {
      "rel": "preconnect",
      "href": "https://fonts.gstatic.com"
    }
  ],
  "local_route_rewrites": [
    {
      "from": "/privacy-choices",
      "to": "privacy-choices.html"
    },
    {
      "from": "/delete-account",
      "to": "delete-account.html"
    },
    {
      "from": "/privacy",
      "to": "privacy.html"
    },
    {
      "from": "/support",
      "to": "support.html"
    },
    {
      "from": "/terms",
      "to": "terms.html"
    },
    {
      "from": "/public/legal.css",
      "to": "legal.css"
    },
    {
      "from": "/",
      "to": "bundle-index.html"
    }
  ],
  "allowed_source_prefixes": [
    "index.html",
    "src/",
    "public/",
    "assets/vendor/",
    "assets/p21/logos/"
  ],
  "forbidden_source_prefixes": [
    "src/authority.js",
    "server/",
    "tests/",
    "deploy/",
    "scripts/",
    "docs/",
    "native/",
    ".git/",
    ".github/",
    ".agents/",
    ".artifacts/",
    "Mega-XO-V5-Implementation-Pack/"
  ],
  "forbidden_source_names": [
    ".env",
    ".env.example",
    "package.json",
    "package-lock.json",
    "Dockerfile",
    ".dockerignore",
    ".gitignore",
    "AGENTS.md",
    "AGENT-GOAL.md",
    "README.md"
  ],
  "forbidden_destination_segments": [
    "authority",
    "server",
    "credential",
    "secret",
    ".git",
    ".env"
  ],
