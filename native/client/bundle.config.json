{
  "schema_version": 1,
  "description": "Allowlisted client bundle graph consumed by scripts/v5/build-client.js. Only paths listed here (and files under vendor_root with known pinned provenance) may enter a bundle. Server authority, credentials, tests, deploy tooling and repository metadata are never bundle inputs.",
  "bundle_index": "bundle-index.html",
  "manifest": "client-bundle.manifest.json",
  "web_index": "index.html",
  "client_scripts": [
    "src/game.js",
    "src/domain.js",
    "src/monetization.js",
    "src/lan-icons.js",
    "src/icons.js",
    "src/account-client.js",
    "src/network.js",
    "src/app.js",
    "src/tournament.js",
    "src/party-ui.js",
    "src/community.js",
    "src/monetization-ui.js"
  ],
  "client_styles": [
    "src/styles.css",
    "src/party.css",
    "src/community.css",
    "src/monetization.css"
  ],
  "legal_pages": [
    {
      "source": "public/privacy.html",
      "destination": "privacy.html"
    },
    {
      "source": "public/terms.html",
      "destination": "terms.html"
    },
    {
      "source": "public/support.html",
      "destination": "support.html"
    },
    {
      "source": "public/privacy-choices.html",
