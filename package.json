{
  "name": "mega-xo",
  "version": "4.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "python3 -m http.server 8080",
    "start:production": "sh deploy/run.sh",
    "start:lan": "node server/party-server.js",
    "start:accounts": "node server/community-server.js",
    "ops": "node scripts/ops.js",
    "test": "node --test tests/*.test.js",
    "test:production": "node --test tests/production-*.test.js",
    "test:load": "node scripts/load-smoke.js",
    "test:balance": "node tests/balance.js",
    "test:ui": "python3 tests/economy-ui.py",
    "test:parties": "node --test tests/tournament.test.js tests/rooms.test.js tests/party-http.test.js",
    "test:party-ui": "python3 tests/party-browser.py",
    "test:matchmaking": "node --test tests/matchmaking.test.js",
    "test:accounts": "node --test tests/community.test.js tests/community-http.test.js tests/email-auth.test.js tests/email-provider.test.js",
    "test:account-ui": "python3 tests/community-ui.py",
    "test:economy-sim": "node tests/economy-sim.js",
    "test:invariants": "node --test tests/design-invariants.test.js",
    "test:monetization": "node --test tests/monetization-*.test.js",
    "test:monetization-model": "node tests/monetization-model.js",
    "test:monetization-ui": "python3 tests/monetization-ui.py",
    "test:capacity": "node scripts/capacity-acceptance.js",
    "db:maintenance": "node scripts/db-maintenance.js",
    "test:db-growth": "node scripts/db-growth-smoke.js"
  },
  "author": "Antimatter Innovations <contact@antimatterinnovations.com>"
}
