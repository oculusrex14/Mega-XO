{
  "name": "mega-xo",
  "version": "3.4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "python3 -m http.server 8080",
    "start:lan": "node server/party-server.js",
    "test": "node --test tests/*.test.js",
    "test:balance": "node tests/balance.js",
    "test:ui": "python3 tests/economy-ui.py",
    "test:parties": "node --test tests/tournament.test.js tests/rooms.test.js tests/party-http.test.js",
    "test:party-ui": "python3 tests/party-browser.py",
    "test:matchmaking": "node --test tests/matchmaking.test.js",
    "start:accounts": "node server/community-server.js",
    "test:accounts": "node --test tests/community.test.js tests/community-http.test.js",
    "test:account-ui": "python3 tests/community-ui.py",
    "test:economy-sim": "node tests/economy-sim.js",
    "test:invariants": "node --test tests/design-invariants.test.js"
  }
}
